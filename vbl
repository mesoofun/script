btnInject.MouseButton1Click:Connect(function()
    if not SCRIPT_INJECTED then
        SCRIPT_INJECTED = true
        btnInject.Text = "Script Injected"
        btnInject.BackgroundColor3 = Color3.fromRGB(50, 40, 55)
        vblStatus.Text = "Status: Injected (Keys 1 & 2 active)"
        vblStatus.TextColor3 = Color3.fromRGB(170, 226, 178)
    else
        SCRIPT_INJECTED = false
        btnInject.Text = "Inject VBL Script"
        btnInject.BackgroundColor3 = Color3.fromRGB(232, 164, 205)
        vblStatus.Text = "Status: Not Injected"
        vblStatus.TextColor3 = Color3.fromRGB(170, 162, 175)
        autoShiftEnabled = false
        tracerVisible = false
        for _, data in pairs(tracers) do data.line.Visible = false end
        releaseShift()
        stopRotation()
    end
end)

UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.F1 then
        mainGui.Enabled = not mainGui.Enabled
    end
end)

if getgenv then
    if getgenv().mesoofun_gui and getgenv().mesoofun_gui.Parent then
        getgenv().mesoofun_gui:Destroy()
    end
    getgenv().mesoofun_gui = mainGui
end
