local function pressShift()
    if shiftHeld then return end
    shiftHeld = true
    pcall(function() VirtualUser:CaptureController() end)
    pcall(keypress, 0x10)
end

local function releaseShift()
    if not shiftHeld then return end
    shiftHeld = false
    pcall(keyrelease, 0x10)
end

local function stopRotation()
    rotating = false
    if rotateConn then rotateConn:Disconnect(); rotateConn = nil end
end

local function startRotation()
    if not autoShiftEnabled or rotating then return end
    rotating = true
    rotateEndTime = os.clock() + ROTATE_DURATION

    rotateConn = RunService.RenderStepped:Connect(function()
        local char = LocalPlayer.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        
        if os.clock() >= rotateEndTime or not (hum and hrp) then
            stopRotation()
            return
        end

        local cam = Workspace.CurrentCamera
        if not cam then return end

        local look = cam.CFrame.LookVector
        local flat = Vector3.new(look.X, 0, look.Z)
        if flat.Magnitude > 0.01 then
            hrp.CFrame = CFrame.lookAt(hrp.Position, hrp.Position + flat.Unit)
        end
    end)
end

local function onCharacter(char)
    if humConn then humConn:Disconnect(); humConn = nil end
    stopRotation()

    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end

    humConn = hum.StateChanged:Connect(function(_, new)
        if new == Enum.HumanoidStateType.Jumping or new == Enum.HumanoidStateType.Freefall then
            if autoShiftEnabled then
                pressShift()
                startRotation()
            end
        elseif new == Enum.HumanoidStateType.Landed or new == Enum.HumanoidStateType.Running then
            releaseShift()
            stopRotation()
        end
    end)
end

if LocalPlayer.Character then onCharacter(LocalPlayer.Character) end
