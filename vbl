tracerConn = RunService.RenderStepped:Connect(function()
    if not SCRIPT_INJECTED then return end
    for player, data in pairs(tracers) do
        if not player.Parent then removeTracer(player) else pcall(updateTracer, player, data) end
    end
end)

UIS.InputBegan:Connect(function(input, gp)
    if gp or not SCRIPT_INJECTED then return end
    if input.KeyCode == Enum.KeyCode.Space and autoShiftEnabled then
        pressShift(); startRotation()
    elseif input.KeyCode == Enum.KeyCode.One then
        autoShiftEnabled = not autoShiftEnabled
        if not autoShiftEnabled then releaseShift(); stopRotation() end
        print("[AutoShift] Включен: " .. tostring(autoShiftEnabled))
    elseif input.KeyCode == Enum.KeyCode.Two then
        tracerVisible = not tracerVisible
        if not tracerVisible then for _, data in pairs(tracers) do data.line.Visible = false end end
        print("[Tracer] Включен: " .. tostring(tracerVisible))
    end
end)

UIS.InputEnded:Connect(function(input, gp)
    if gp or not SCRIPT_INJECTED then return end
    if input.KeyCode == Enum.KeyCode.Space then releaseShift() end
end)

