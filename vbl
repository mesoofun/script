local function getHead(player)
    local char = player.Character
    if not char then return nil end
    local head = char:FindFirstChild("Head")
    if head and head:IsA("BasePart") then return head end
    return char:FindFirstChild("HumanoidRootPart")
end

local function getLookVector(player)
    local char = player.Character
    if not char then return nil end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and hrp:IsA("BasePart") then return hrp.CFrame.LookVector end
    return nil
end

local function getColorForPlayer(player)
    if player == LocalPlayer then return COLOR_SELF_TEAM end
    local localTeam = LocalPlayer.Team
    local playerTeam = player.Team
    if not localTeam or not playerTeam then return COLOR_NEUTRAL end
    return (localTeam == playerTeam) and COLOR_SELF_TEAM or COLOR_ENEMY
end

local function createTracer()
    local line = Drawing.new("Line")
    line.Visible, line.Thickness, line.Color, line.Transparency = false, LINE_THICKNESS, COLOR_NEUTRAL, LINE_ALPHA
    line.From, line.To = Vector2.new(), Vector2.new()
    return line
end

local function updateTracer(player, data)
    if not tracerVisible then data.line.Visible = false; return end
    local head, look = getHead(player), getLookVector(player)
    if not head or not look then data.line.Visible = false; return end
    local localChar = LocalPlayer.Character
    local localHRP  = localChar and localChar:FindFirstChild("HumanoidRootPart")
    if localHRP and (head.Position - localHRP.Position).Magnitude > MAX_DISTANCE then
        data.line.Visible = false; return
    end

    data.line.Color = getColorForPlayer(player)
    local origin = head.Position
    local target = origin + look * LINE_LENGTH
    local originScreen, originOnScreen = Camera:WorldToViewportPoint(origin)
    local targetScreen, targetOnScreen = Camera:WorldToViewportPoint(target)

    if not (originOnScreen or targetOnScreen) then data.line.Visible = false; return end

    local vp = Camera.ViewportSize
    local function clampScreen(p)
        return Vector2.new(math.clamp(p.X, -vp.X, vp.X * 2), math.clamp(p.Y, -vp.Y, vp.Y * 2))
    end

    data.line.From    = clampScreen(Vector2.new(originScreen.X, originScreen.Y))
    data.line.To      = clampScreen(Vector2.new(targetScreen.X, targetScreen.Y))
    data.line.Visible = true
end

local function setupPlayer(player)
    if player == LocalPlayer and not SHOW_LOCAL then return end
    if tracers[player] then return end
    tracers[player] = { line = createTracer() }
    player.CharacterAdded:Connect(function()
        task.wait(0.5)
        if player.Parent and tracers[player] then tracers[player].line.Visible = false end
    end)
    player:GetPropertyChangedSignal("Team"):Connect(function()
        if tracers[player] then tracers[player].line.Color = getColorForPlayer(player) end
    end)
end

local function removeTracer(player)
    local d = tracers[player]
    if d then if d.line then d.line:Remove() end; tracers[player] = nil end
end

for _, p in ipairs(Players:GetPlayers()) do setupPlayer(p) end
