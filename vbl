local function refreshFileList()
    for _, child in ipairs(fileMenu:GetChildren()) do
        if child:IsA("TextButton") or child:IsA("TextLabel") then child:Destroy() end
    end
    
    local files = listfiles(FOLDER_NAME)
    local hasFiles = false
    
    if files then
        for _, file in ipairs(files) do
            local lowerFile = string.lower(file)
            if string.sub(lowerFile, -5) == ".json" then
                hasFiles = true
                local btn = Instance.new("TextButton")
                btn.Size = UDim2.new(1, -5, 0, 20)
                btn.BackgroundColor3 = Color3.fromRGB(50, 40, 55)
                btn.Font = Enum.Font.GothamMedium
                btn.TextSize = 10
                btn.TextColor3 = Color3.fromRGB(242, 236, 244)
                btn.Text = file
                btn.TextXAlignment = Enum.TextXAlignment.Left
                btn.Parent = fileMenu
                createCorner(btn, 3)
                
                local btnPad = Instance.new("UIPadding")
                btnPad.PaddingLeft = UDim.new(0, 5)
                btnPad.Parent = btn
                
                btn.MouseButton1Click:Connect(function()
                    local success, content = pcall(readfile, FOLDER_NAME .. "/" .. file)
                    if success and content then
                        ffBox.Text = content
                        ffStatus.Text = "Loaded: " .. file
                        ffStatus.TextColor3 = Color3.fromRGB(170, 226, 178)
                        fileMenu.Visible = false
                    end
                end)
            end
        end
    end
    
    if not hasFiles then
        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, -5, 0, 20)
        lbl.BackgroundTransparency = 1
        lbl.Font = Enum.Font.GothamMedium
        lbl.TextSize = 10
        lbl.TextColor3 = Color3.fromRGB(170, 162, 175)
        lbl.Text = "No .json files in /FASTFLAGS"
        lbl.Parent = fileMenu
    end
end

