local appliedFlags = {}

local function applyFlags()
    local jsonString = ffBox.Text
    if jsonString == "" then
        ffStatus.Text = "Error: JSON is empty."
        ffStatus.TextColor3 = Color3.fromRGB(255, 120, 130)
        return
    end
    
    local success, decoded = pcall(function()
        return game:GetService("HttpService"):JSONDecode(jsonString)
    end)
    
    if not success or type(decoded) ~= "table" then
        ffStatus.Text = "Error: Invalid JSON format."
        ffStatus.TextColor3 = Color3.fromRGB(255, 120, 130)
        return
    end
    
    pcall(writefile, SAVE_FILE, jsonString)
    local count = 0
    appliedFlags = {}
    
    for flag, value in pairs(decoded) do
        local valType = type(value)
        local formattedValue = value
        if valType == "boolean" then formattedValue = value and "True" or "False" end
        
        local ok = pcall(setfflag, flag, formattedValue)
        if ok then
            count = count + 1
            appliedFlags[flag] = valType
        end
    end
    
    ffStatus.Text = "Applied & Saved " .. tostring(count) .. " flags."
    ffStatus.TextColor3 = Color3.fromRGB(170, 226, 178)
end

local function disableFlags()
    local count = 0
    for flag, valType in pairs(appliedFlags) do
        local resetValue = ""
        if valType == "boolean" then resetValue = "False"
        elseif valType == "number" then resetValue = 0
        end
        if pcall(setfflag, flag, resetValue) then count = count + 1 end
    end
    appliedFlags = {}
    ffStatus.Text = "Attempted to reset " .. tostring(count) .. " flags."
    ffStatus.TextColor3 = Color3.fromRGB(232, 200, 140)
end

local function clearText()
